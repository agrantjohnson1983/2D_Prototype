  m_Name: SO_Dialogue_Scene_01_Opening 1
  m_EditorClassIdentifier: 
  dialogueBits:
  - characterName: Cam
    characterImage: {fileID: -894542136, guid: bb01e7ef587b2364a8d1617a213f9e84, type: 3}
    typingLettersPerSec: 0.1
    delayAtEndOfTyping: 1
    textDialogue: What is this place?
    choices: []
  - characterName: Gael
    characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
    typingLettersPerSec: 0.1
    delayAtEndOfTyping: 1
    textDialogue: It's an abandoned shop!
    choices:
    - textChoice: Why did you bring me here?
      nextDialogueBit:
        characterName: Gael
        characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 1
        textDialogue: Come on live a little and let's explore!
        choices: []
    - textChoice: Cool!  This is awesome!
      nextDialogueBit:
        characterName: Gael
        characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 1
        textDialogue: Yeah!  Right!?
        choices:
        - textChoice: I mean it's kind of creepy....
          nextDialogueBit:
            characterName: Gael
            characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
            typingLettersPerSec: 0.1
            delayAtEndOfTyping: 0
            textDialogue: You're kind of creepy!
            choices: []
        - textChoice: So what's next?
          nextDialogueBit:
            characterName: 
            characterImage: {fileID: 0}
            typingLettersPerSec: 0
            delayAtEndOfTyping: 0
            textDialogue: 
            choices: []
  - characterName: Gael
    characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
    typingLettersPerSec: 0.1
    delayAtEndOfTyping: 1
    textDialogue: I heard there's possibly some REAL magic stuff hidden here!
    choices:
    - textChoice: Bullshit!
      nextDialogueBit:
        characterName: Mae
        characterImage: {fileID: 21300000, guid: 29ccaa77dbc44c747a9884684a8474fa, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 0
        textDialogue: Oh god is this going to be another one of your rants...?
        choices: []
    - textChoice: Whaaaat!?
      nextDialogueBit:
        characterName: Mae
        characterImage: {fileID: 21300000, guid: 29ccaa77dbc44c747a9884684a8474fa, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 0
        textDialogue: That is so cool!  I wonder what there could be....
        choices: []
  - characterName: Gael
    characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
    typingLettersPerSec: 0.1
    delayAtEndOfTyping: 1
    textDialogue: I'm going to look around and see if there's anything interesting.
    choices:
    - textChoice: Uhhh guess I'll do the same
      nextDialogueBit:
        characterName: Gael
        characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 0
        textDialogue: You do you!
        choices: []
    - textChoice: Sounds fun!  I'm down!
      nextDialogueBit:
        characterName: 
        characterImage: {fileID: 0}
        typingLettersPerSec: 0
        delayAtEndOfTyping: 0
        textDialogue: 
        choices: []
    - textChoice: Oh boy here we go....
      nextDialogueBit:
        characterName: Gael
        characterImage: {fileID: -75513689, guid: c136d9b9fd0e1a44eb2ce6126da4e7b8, type: 3}
        typingLettersPerSec: 0.1
        delayAtEndOfTyping: 0
        textDialogue: Dont' be a tuna head!
        choices: []
